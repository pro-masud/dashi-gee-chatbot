    function isValidChannelWebhookEvent(data) {
      return data.keys().hasAll(['channel', 'eventId', 'senderId', 'status', 'createdAtIso', 'createdAt'])
        && data.keys().hasOnly(['channel', 'eventId', 'senderId', 'verifiedPhone', 'status', 'createdAtIso', 'createdAt'])
        && data.channel in ['messenger', 'instagram', 'whatsapp']
        && data.eventId is string && data.eventId.size() >= 2 && data.eventId.size() <= 128
        && data.senderId is string && data.senderId.size() >= 2 && data.senderId.size() <= 128
        && (!('verifiedPhone' in data) || (data.verifiedPhone is string && (data.verifiedPhone == '' || data.verifiedPhone.matches('^01[3-9][0-9]{8}$'))))
        && data.status in ['processed', 'duplicate', 'rejected']
        && data.createdAtIso is string && data.createdAtIso.size() <= 48
        && data.createdAt == request.time;
    }

    function isValidMarketingConsent(data) {
      return data.keys().hasAll([
          'phone', 'channel', 'optIn', 'unsubscribed', 'source',
          'quietHoursRespect', 'consentTimestampIso', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'phone', 'customerName', 'channel', 'optIn', 'unsubscribed', 'source',
          'quietHoursRespect', 'consentTimestampIso', 'lastCampaignAtIso', 'campaignCount',
          'createdAt', 'updatedAt'
        ])
        && data.phone is string && data.phone.matches('^01[3-9][0-9]{8}$')
        && (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100))
        && data.channel in ['web', 'messenger', 'instagram', 'whatsapp', 'email', 'sms']
        && data.optIn is bool
        && data.unsubscribed is bool
        && data.source in ['checkout', 'chat', 'track_order', 'whatsapp', 'admin']
        && data.quietHoursRespect is bool
        && data.consentTimestampIso is string && data.consentTimestampIso.size() <= 48
        && (!('lastCampaignAtIso' in data) || (data.lastCampaignAtIso is string && data.lastCampaignAtIso.size() <= 48))
        && (!('campaignCount' in data) || (data.campaignCount is number && data.campaignCount >= 0 && data.campaignCount <= 1000))
        && data.updatedAt == request.time;
    }

    function isValidPaymentGatewayEvent(data) {
      return data.keys().hasAll([
          'provider', 'eventType', 'orderNumber', 'externalRef',
          'rawStatus', 'verified', 'createdAtIso', 'createdAt'
        ])
        && data.keys().hasOnly([
          'provider', 'eventType', 'orderNumber', 'externalRef',
          'amountBdt', 'rawStatus', 'verified', 'createdAtIso', 'createdAt'
        ])
        && data.provider in ['sslcommerz', 'bkash', 'steadfast', 'pathao', 'redx']
        && data.eventType in ['payment_verified', 'payment_failed', 'payment_cancelled', 'courier_status']
        && data.orderNumber is string && data.orderNumber.matches('^DG-[0-9]{4,8}$')
        && data.externalRef is string && data.externalRef.size() >= 2 && data.externalRef.size() <= 128
        && (!('amountBdt' in data) || (data.amountBdt is number && data.amountBdt >= 0 && data.amountBdt <= 500000))
        && data.rawStatus is string && data.rawStatus.size() >= 1 && data.rawStatus.size() <= 64
        && data.verified is bool
        && data.createdAtIso is string && data.createdAtIso.size() <= 48
        && data.createdAt == request.time;
    }

    match /store_settings/{docId} {
      allow get: if isValidId(docId) && (docId == 'main' || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(docId) && isAdmin() && isValidStoreSettings(incoming());
      allow update: if isValidId(docId) && isValidStoreSettings(incoming()) && (
        isAdmin()
        || (
          docId == 'main'
          && incoming().diff(existing()).affectedKeys().hasOnly(['stock250g', 'stock500g', 'stock1kg', 'lastOrderNumber', 'updatedAt'])
          && incoming().lastOrderNumber is string
          && incoming().lastOrderNumber.matches('^DG-[0-9]{4,8}$')
          && existsAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber))
          && (
            (
              !exists(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber))
              && incoming().stock250g == existing().stock250g - getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty250g
              && incoming().stock500g == existing().stock500g - getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty500g
              && incoming().stock1kg == existing().stock1kg - getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty1kg
            )
            || (
              exists(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber))
              && get(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.status in ['pending', 'confirmed', 'processing']
              && getAfter(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.status == 'cancelled'
              && incoming().stock250g == existing().stock250g + get(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty250g
              && incoming().stock500g == existing().stock500g + get(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty500g
              && incoming().stock1kg == existing().stock1kg + get(/databases/$(database)/documents/orders/$(incoming().lastOrderNumber)).data.qty1kg
            )
          )
        )
      );
      allow delete: if false;
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderNumber == orderId
        && incoming().createdAt == request.time
        && incoming().status == 'pending'
        && (
          (incoming().paymentMethod == 'cod' && incoming().paymentStatus == 'cod_due')
          || (incoming().paymentMethod in ['bkash', 'nagad'] && incoming().paymentStatus == 'pending_verification' && incoming().txnId.size() >= 4)
        )
        && matchesCanonicalStorePricing(incoming())
        && existsAfter(/databases/$(database)/documents/order_tracking/$(orderId + '_' + incoming().phone));
      allow update: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().orderNumber == existing().orderNumber
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paymentStatus', 'webhookStatus', 'reviewStatus',
              'courierPartner', 'consignmentId', 'courierTrackingUrl', 'dispatchedAtIso', 'updatedAt'
            ])
          )
          || (
            existing().status in ['pending', 'confirmed']
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/order_tracking/$(orderId + '_' + existing().phone))
            && getAfter(/databases/$(database)/documents/order_tracking/$(orderId + '_' + existing().phone)).data.status == 'cancelled'
          )
          || (
            existing().status in ['pending', 'confirmed']
            && incoming().status == existing().status
            && incoming().subtotalBdt == existing().subtotalBdt
            && incoming().discountBdt == existing().discountBdt
            && matchesCanonicalStorePricing(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly(['district', 'area', 'address', 'deliveryZone', 'deliveryFeeBdt', 'totalBdt', 'estimatedDelivery', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/order_tracking/$(orderId + '_' + existing().phone))
          )
        );
      allow delete: if isValidId(orderId) && isAdmin();
    }

    match /order_tracking/{lookupId} {
      allow get: if isValidId(lookupId);
      allow list: if isAdmin();
      allow create: if isValidId(lookupId)
        && isValidOrderTracking(incoming())
        && incoming().status == 'pending'
        && incoming().paymentStatus in ['cod_due', 'pending_verification']
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderNumber));
      allow update: if isValidId(lookupId)
        && isValidOrderTracking(incoming())
        && incoming().orderNumber == existing().orderNumber
        && (
          (
            isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'paymentStatus', 'estimatedDelivery', 'reviewStatus',
              'courierPartner', 'consignmentId', 'courierTrackingUrl', 'dispatchedAtIso', 'updatedAt'
            ])
          )
          || (
            existing().status in ['pending', 'confirmed']
            && incoming().diff(existing()).affectedKeys().hasOnly(['district', 'deliveryZone', 'deliveryFeeBdt', 'totalBdt', 'estimatedDelivery', 'status', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/orders/$(existing().orderNumber)).data.updatedAt == request.time
          )
        );
      allow delete: if isValidId(lookupId) && isAdmin();
    }

    match /batches/{batchId} {
      allow get: if isValidId(batchId);
      allow list: if existing().active == true || isAdmin();
      allow create, update: if isValidId(batchId) && isAdmin() && isValidBatch(incoming());
      allow delete: if isValidId(batchId) && isAdmin();
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId) && (existing().status == 'approved' || isAdmin());
      allow list: if existing().status == 'approved' || isAdmin();
      allow create: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'pending'
        && incoming().helpfulCount == 0
        && (
          incoming().verifiedPurchase == false
          || (
            incoming().verifiedPurchase == true
            && incoming().orderNumber.matches('^DG-[0-9]{4,8}$')
            && reviewId == 'rev_' + incoming().orderNumber
            && existsAfter(/databases/$(database)/documents/order_review_claims/$(incoming().orderNumber))
          )
        );
      allow update: if isValidId(reviewId)
        && isValidReview(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'verifiedPurchase']))
          || (
            existing().status == 'approved'
            && incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount'])
            && incoming().helpfulCount == existing().helpfulCount + 1
          )
        );
      allow delete: if isValidId(reviewId) && isAdmin();
    }

    match /coupons/{code} {
      allow get: if isValidId(code) && (existing().active == true || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(code) && isAdmin() && isValidCoupon(incoming());
      allow delete: if isValidId(code) && isAdmin();
    }

    match /subscribers/{subId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(subId) && isValidSubscriber(incoming());
      allow update, delete: if isValidId(subId) && isAdmin();
    }

    match /admins/{uid} {
      allow get: if isValidId(uid) && isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /chatbot_config/{docId} {
      allow get: if isValidId(docId) && (docId == 'published' || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(docId)
        && (docId == 'published' || docId == 'draft')
        && isAdmin()
        && isValidChatbotConfig(incoming());
      allow delete: if false;
    }

    match /chatbot_config_versions/{versionId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(versionId) && isAdmin() && isValidChatbotVersion(incoming());
      allow update: if false;
      allow delete: if isValidId(versionId) && isAdmin();
    }

    match /chatbot_faqs/{faqId} {
      allow get: if isValidId(faqId) && ((existing().active == true && existing().published == true) || isAdmin());
      allow list: if (existing().active == true && existing().published == true) || isAdmin();
      allow create, update: if isValidId(faqId) && isAdmin() && isValidChatbotFaq(incoming());
      allow delete: if isValidId(faqId) && isAdmin();
    }

    match /chatbot_kb_docs/{docId} {
      allow get: if isValidId(docId) && ((existing().status == 'published' && (!('accessScope' in existing()) || existing().accessScope == 'public')) || isAdmin());
      allow list: if (existing().status == 'published' && (!('accessScope' in existing()) || existing().accessScope == 'public')) || isAdmin();
      allow create, update: if isValidId(docId) && isAdmin() && isValidChatbotKbDoc(incoming());
      allow delete: if isValidId(docId) && isAdmin();
    }

    match /chatbot_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isValidChatbotLog(incoming())
        && incoming().createdAt == request.time
        && incoming().resolved == false;
      allow update: if isValidId(logId)
        && isAdmin()
        && isValidChatbotLog(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'feedback', 'feedbackReason']);
      allow delete: if isValidId(logId) && isAdmin();
    }

    match /chatbot_support_requests/{reqId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(reqId)
        && isValidSupportRequest(incoming())
        && incoming().createdAt == request.time
        && incoming().status == 'open'
        && !('assignedTo' in incoming())
        && !('internalNotes' in incoming())
        && !('resolvedAtIso' in incoming())
        && !('firstRespondedAtIso' in incoming())
        && !('resolutionReason' in incoming());
      allow update: if isValidId(reqId)
        && isAdmin()
        && isValidSupportRequest(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'priority', 'assignedTo', 'tags', 'resolutionReason',
          'internalNotes', 'firstRespondedAtIso', 'resolvedAtIso', 'updatedAt'
        ]);
      allow delete: if isValidId(reqId) && isAdmin();
    }

    match /chatbot_used_tokens/{tokenId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(tokenId)
        && isValidChatbotUsedToken(incoming())
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderNumber));
      allow update, delete: if false;
    }

    match /chatbot_order_idempotency/{idemKey} {
      allow get: if isValidId(idemKey);
      allow list: if isAdmin();
      allow create: if isValidId(idemKey)
        && isValidChatbotOrderIdempotency(incoming())
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderNumber));
      allow update, delete: if false;
    }

    match /chatbot_rate_buckets/{bucketId} {
      allow get: if isValidId(bucketId);
      allow list: if isAdmin();
      allow create: if isValidId(bucketId)
        && isValidChatbotRateBucket(incoming())
        && incoming().count == 1;
      allow update: if isValidId(bucketId)
        && isValidChatbotRateBucket(incoming())
        && (incoming().count == existing().count + 1 || incoming().count == 1);
      allow delete: if isValidId(bucketId) && isAdmin();
    }

    match /chatbot_cost_ledger/{dateKey} {
      allow get: if isValidId(dateKey);
      allow list: if isAdmin();
      allow create: if isValidId(dateKey)
        && isValidChatbotCostLedger(incoming())
        && incoming().dateKey == dateKey
        && incoming().requestCount == 1
        && incoming().totalUsd <= 0.5;
      allow update: if isValidId(dateKey)
        && isValidChatbotCostLedger(incoming())
        && incoming().dateKey == existing().dateKey
        && incoming().requestCount == existing().requestCount + 1
        && incoming().totalUsd >= existing().totalUsd
        && (incoming().totalUsd - existing().totalUsd) <= 0.5;
      allow delete: if isValidId(dateKey) && isAdmin();
    }

    match /knowledge_chunks/{chunkId} {
      allow get: if isValidId(chunkId) && ((existing().status == 'published' && existing().accessScope == 'public') || isAdmin());
      allow list: if (existing().status == 'published' && existing().accessScope == 'public') || isAdmin();
      allow create, update: if isValidId(chunkId) && isAdmin() && isValidKnowledgeChunk(incoming());
      allow delete: if isValidId(chunkId) && isAdmin();
    }

    // S0-02: Server-only session & draft storage (zero anonymous/client direct read or write).
    // Customer access goes strictly through /api/chat/session with signed HttpOnly cookie ownership.
    match /chat_sessions/{sessionId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(sessionId)
        && isAdmin()
        && isValidChatSession(incoming())
        && incoming().sessionId == sessionId;
      allow delete: if isValidId(sessionId) && isAdmin();
    }

    match /order_drafts/{draftId} {
      allow get, list: if isAdmin();
      allow create, update: if isValidId(draftId)
        && isAdmin()
        && isValidOrderDraft(incoming())
        && incoming().draftId == draftId;
      allow delete: if isValidId(draftId) && isAdmin();
    }

    match /chatbot_feedback/{feedbackId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(feedbackId)
        && isValidChatbotFeedback(incoming())
        && incoming().createdAt == request.time;
      allow update: if isValidId(feedbackId)
        && isAdmin()
        && isValidChatbotFeedback(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['resolved']);
      allow delete: if isValidId(feedbackId) && isAdmin();
    }

    match /order_fingerprints/{fingerprintId} {
      allow get: if isValidId(fingerprintId);
      allow list: if isAdmin();
      allow create, update: if isValidId(fingerprintId)
        && isValidOrderFingerprint(incoming())
        && existsAfter(/databases/$(database)/documents/orders/$(incoming().orderNumber));
      allow delete: if isValidId(fingerprintId) && isAdmin();
    }

    match /order_audit_logs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(logId)
        && isValidOrderAuditLog(incoming())
        && (
          isAdmin()
          || existsAfter(/databases/$(database)/documents/orders/$(incoming().orderNumber))
          || exists(/databases/$(database)/documents/orders/$(incoming().orderNumber))
        );
      allow update, delete: if false;
    }

    match /support_evidence/{evidenceId} {
      allow get: if isValidId(evidenceId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(evidenceId) && isValidSupportEvidence(incoming());
      allow update, delete: if isValidId(evidenceId) && isAdmin();
    }

    match /support_agent_replies/{replyId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(replyId) && isAdmin() && isValidSupportAgentReply(incoming());
      allow update, delete: if false;
    }

    match /order_review_claims/{orderNumber} {
      allow get, list: if isAdmin();
      allow create: if isValidId(orderNumber)
        && isValidOrderReviewClaim(incoming())
        && incoming().orderNumber == orderNumber
        && get(/databases/$(database)/documents/orders/$(orderNumber)).data.status == 'delivered'
        && existsAfter(/databases/$(database)/documents/reviews/$('rev_' + orderNumber));
      allow update, delete: if isValidId(orderNumber) && isAdmin();
    }

    // S0-03: Server-only refill reminder & marketing consent records (zero anonymous/client read or write).
    match /refill_reminders/{reminderId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(reminderId)
        && isAdmin()
        && isValidRefillReminder(incoming())
        && incoming().createdAt == request.time
        && reminderId == incoming().orderNumber + '_' + incoming().phone;
      allow update: if isValidId(reminderId)
        && isAdmin()
        && isValidRefillReminder(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(reminderId) && isAdmin();
    }

    match /channel_webhook_events/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId) && isValidChannelWebhookEvent(incoming());
      allow update, delete: if false;
    }

    match /marketing_consents/{phoneKey} {
      allow get, list: if isAdmin();
      allow create: if isValidId(phoneKey)
        && isAdmin()
        && isValidMarketingConsent(incoming())
        && incoming().createdAt == request.time
        && phoneKey == incoming().phone;
      allow update: if isValidId(phoneKey)
        && isAdmin()
        && isValidMarketingConsent(incoming())
        && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(phoneKey) && isAdmin();
    }

    match /payment_gateway_events/{eventId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(eventId)
        && isValidPaymentGatewayEvent(incoming())
        && exists(/databases/$(database)/documents/orders/$(incoming().orderNumber));
      allow update, delete: if false;
    }
  }
}
