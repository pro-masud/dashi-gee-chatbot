rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Bootstrapped connection check doc
    match /test/connection {
      allow get: if true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'kinboni.bd@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll([
          'productNameEn', 'productNameBn', 'taglineEn', 'taglineBn',
          'originLocation', 'price250g', 'price500g', 'price1kg',
          'stock250g', 'stock500g', 'stock1kg', 'insideDhakaFee',
          'outsideDhakaFee', 'freeDeliveryThreshold', 'estimatedDhakaDays',
          'estimatedOutsideDays', 'bkashNumber', 'nagadNumber',
          'advanceDiscountPct', 'whatsappNumber', 'supportPhone',
          'supportEmail', 'businessAddress', 'facebookUrl', 'instagramUrl',
          'activeBatchCode', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'productNameEn', 'productNameBn', 'taglineEn', 'taglineBn',
          'originLocation', 'price250g', 'price500g', 'price1kg',
          'stock250g', 'stock500g', 'stock1kg', 'insideDhakaFee',
          'dhakaSuburbanFee', 'outsideDhakaFee', 'remoteDistrictFee',
          'freeDeliveryThreshold', 'estimatedDhakaDays', 'estimatedSuburbanDays',
          'estimatedOutsideDays', 'estimatedRemoteDays',
          'dispatchCutoffHourBst', 'cutoffNoticeEn', 'cutoffNoticeBn',
          'codConfirmEnabled', 'codHighValueThresholdBdt', 'lastOrderNumber',
          'bkashNumber', 'nagadNumber',
          'advanceDiscountPct', 'whatsappNumber', 'supportPhone',
          'supportEmail', 'businessAddress', 'facebookUrl', 'instagramUrl',
          'activeBatchCode', 'updatedAt'
        ])
        && data.productNameEn is string && data.productNameEn.size() >= 2 && data.productNameEn.size() <= 120
        && data.productNameBn is string && data.productNameBn.size() >= 2 && data.productNameBn.size() <= 160
        && data.taglineEn is string && data.taglineEn.size() <= 180
        && data.taglineBn is string && data.taglineBn.size() <= 240
        && data.originLocation is string && data.originLocation.size() <= 120
        && data.price250g is number && data.price250g > 0
        && data.price500g is number && data.price500g > 0
        && data.price1kg is number && data.price1kg > 0
        && data.stock250g is number && data.stock250g >= 0
        && data.stock500g is number && data.stock500g >= 0
        && data.stock1kg is number && data.stock1kg >= 0
        && data.insideDhakaFee is number && data.insideDhakaFee >= 0
        && (!('dhakaSuburbanFee' in data) || (data.dhakaSuburbanFee is number && data.dhakaSuburbanFee >= 0))
        && data.outsideDhakaFee is number && data.outsideDhakaFee >= 0
        && (!('remoteDistrictFee' in data) || (data.remoteDistrictFee is number && data.remoteDistrictFee >= 0))
        && data.freeDeliveryThreshold is number && data.freeDeliveryThreshold >= 0
        && data.estimatedDhakaDays is string && data.estimatedDhakaDays.size() <= 80
        && (!('estimatedSuburbanDays' in data) || (data.estimatedSuburbanDays is string && data.estimatedSuburbanDays.size() <= 80))
        && data.estimatedOutsideDays is string && data.estimatedOutsideDays.size() <= 80
        && (!('estimatedRemoteDays' in data) || (data.estimatedRemoteDays is string && data.estimatedRemoteDays.size() <= 80))
        && (!('dispatchCutoffHourBst' in data) || (data.dispatchCutoffHourBst is number && data.dispatchCutoffHourBst >= 0 && data.dispatchCutoffHourBst <= 23))
        && (!('cutoffNoticeEn' in data) || (data.cutoffNoticeEn is string && data.cutoffNoticeEn.size() <= 240))
        && (!('cutoffNoticeBn' in data) || (data.cutoffNoticeBn is string && data.cutoffNoticeBn.size() <= 300))
        && (!('codConfirmEnabled' in data) || data.codConfirmEnabled is bool)
        && (!('codHighValueThresholdBdt' in data) || (data.codHighValueThresholdBdt is number && data.codHighValueThresholdBdt >= 0))
        && (!('lastOrderNumber' in data) || (data.lastOrderNumber is string && data.lastOrderNumber.size() <= 20))
        && data.bkashNumber is string && data.bkashNumber.size() <= 30
        && data.nagadNumber is string && data.nagadNumber.size() <= 30
        && data.advanceDiscountPct is number && data.advanceDiscountPct >= 0 && data.advanceDiscountPct <= 50
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 30
        && data.supportPhone is string && data.supportPhone.size() <= 30
        && data.supportEmail is string && data.supportEmail.size() <= 120
        && data.businessAddress is string && data.businessAddress.size() <= 240
        && data.facebookUrl is string && data.facebookUrl.size() <= 200
        && data.instagramUrl is string && data.instagramUrl.size() <= 200
        && data.activeBatchCode is string && data.activeBatchCode.size() <= 40
        && data.updatedAt == request.time;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderNumber', 'customerName', 'phone', 'district', 'area',
          'address', 'note', 'deliveryZone', 'weight', 'qty',
          'qty250g', 'qty500g', 'qty1kg', 'itemsSummary',
          'unitPriceBdt', 'subtotalBdt', 'deliveryFeeBdt', 'discountBdt',
          'totalBdt', 'couponCode', 'paymentMethod', 'paymentStatus',
          'txnId', 'paymentProofData', 'status', 'estimatedDelivery',
          'webhookStatus', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'customerName', 'phone', 'district', 'area',
          'address', 'note', 'deliveryZone', 'weight', 'qty',
          'qty250g', 'qty500g', 'qty1kg', 'itemsSummary',
          'unitPriceBdt', 'subtotalBdt', 'deliveryFeeBdt', 'discountBdt',
          'totalBdt', 'couponCode', 'paymentMethod', 'paymentStatus',
          'txnId', 'paymentProofData', 'status', 'estimatedDelivery',
          'webhookStatus', 'courierPartner', 'consignmentId', 'courierTrackingUrl',
          'dispatchedAtIso', 'riskScore', 'riskSignals', 'reviewStatus',
          'duplicateWarning', 'codVerificationStatus', 'sourceChannel',
          'attributedSessionId', 'createdAt', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.matches('^DG-[0-9]{4,8}$')
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phone is string && data.phone.matches('^01[3-9][0-9]{8}$')
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.area is string && data.area.size() >= 2 && data.area.size() <= 100
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 300
        && data.note is string && data.note.size() <= 240
        && data.deliveryZone in ['dhaka', 'suburban', 'nationwide', 'remote']
        && data.weight in ['250g', '500g', '1kg']
        && data.qty250g is number && data.qty250g >= 0 && data.qty250g <= 50
        && data.qty500g is number && data.qty500g >= 0 && data.qty500g <= 50
        && data.qty1kg is number && data.qty1kg >= 0 && data.qty1kg <= 50
        && data.qty is number && data.qty >= 1 && data.qty <= 50
        && data.qty == data.qty250g + data.qty500g + data.qty1kg
        && data.itemsSummary is string && data.itemsSummary.size() >= 3 && data.itemsSummary.size() <= 80
        && data.unitPriceBdt is number && data.unitPriceBdt > 0
        && data.subtotalBdt is number && data.subtotalBdt > 0
        && data.deliveryFeeBdt is number && data.deliveryFeeBdt >= 0
        && data.discountBdt is number && data.discountBdt >= 0 && data.discountBdt <= data.subtotalBdt
        && data.totalBdt is number && data.totalBdt > 0 && data.totalBdt == data.subtotalBdt + data.deliveryFeeBdt - data.discountBdt
        && data.couponCode is string && data.couponCode.size() <= 32
        && data.paymentMethod in ['cod', 'bkash', 'nagad']
        && data.paymentStatus in ['cod_due', 'pending_verification', 'verified', 'failed']
        && data.txnId is string && data.txnId.size() <= 64
        && data.paymentProofData is string && data.paymentProofData.size() <= 180000
        && data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && data.estimatedDelivery is string && data.estimatedDelivery.size() <= 80
        && data.webhookStatus is string && data.webhookStatus.size() <= 80
        && (!('courierPartner' in data) || data.courierPartner in ['steadfast', 'pathao', 'redx', 'manual'])
        && (!('consignmentId' in data) || (data.consignmentId is string && data.consignmentId.size() <= 80))
        && (!('courierTrackingUrl' in data) || (data.courierTrackingUrl is string && data.courierTrackingUrl.size() <= 300 && (data.courierTrackingUrl == '' || data.courierTrackingUrl.matches('^https://.*'))))
        && (!('dispatchedAtIso' in data) || (data.dispatchedAtIso is string && data.dispatchedAtIso.size() <= 48))
        && (!('riskScore' in data) || (data.riskScore is number && data.riskScore >= 0 && data.riskScore <= 100))
        && (!('riskSignals' in data) || (data.riskSignals is list && data.riskSignals.size() <= 12 && (data.riskSignals.size() == 0 || data.riskSignals[0] is string)))
        && (!('reviewStatus' in data) || data.reviewStatus in ['none', 'manual_review', 'approved', 'rejected'])
        && (!('duplicateWarning' in data) || (data.duplicateWarning is string && data.duplicateWarning.size() <= 240))
        && (!('codVerificationStatus' in data) || data.codVerificationStatus in ['not_required', 'not_configured', 'pending', 'verified'])
        && (!('sourceChannel' in data) || data.sourceChannel in ['web', 'messenger', 'instagram', 'whatsapp', 'email', 'sms'])
        && (!('attributedSessionId' in data) || (data.attributedSessionId is string && data.attributedSessionId.size() <= 64))
        && data.updatedAt == request.time;
    }

    function matchesCanonicalStorePricing(data) {
      return (
        !exists(/databases/$(database)/documents/store_settings/main)
        && data.subtotalBdt == (data.qty250g * 680) + (data.qty500g * 1290) + (data.qty1kg * 2480)
        && (
          (data.weight == '250g' && data.unitPriceBdt == 680)
          || (data.weight == '500g' && data.unitPriceBdt == 1290)
          || (data.weight == '1kg' && data.unitPriceBdt == 2480)
        )
      ) || (
        exists(/databases/$(database)/documents/store_settings/main)
        && data.subtotalBdt == (
          (data.qty250g * get(/databases/$(database)/documents/store_settings/main).data.price250g)
          + (data.qty500g * get(/databases/$(database)/documents/store_settings/main).data.price500g)
          + (data.qty1kg * get(/databases/$(database)/documents/store_settings/main).data.price1kg)
        )
        && (
          (data.weight == '250g' && data.unitPriceBdt == get(/databases/$(database)/documents/store_settings/main).data.price250g)
          || (data.weight == '500g' && data.unitPriceBdt == get(/databases/$(database)/documents/store_settings/main).data.price500g)
          || (data.weight == '1kg' && data.unitPriceBdt == get(/databases/$(database)/documents/store_settings/main).data.price1kg)
        )
      );
    }

    function isValidOrderTracking(data) {
      return data.keys().hasAll([
          'orderNumber', 'weight', 'qty', 'itemsSummary', 'totalBdt', 'paymentMethod',
          'paymentStatus', 'status', 'estimatedDelivery', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderNumber', 'weight', 'qty', 'qty250g', 'qty500g', 'qty1kg',
          'itemsSummary', 'subtotalBdt', 'deliveryFeeBdt', 'discountBdt',
          'couponCode', 'deliveryZone', 'district', 'totalBdt', 'paymentMethod',
          'paymentStatus', 'status', 'reviewStatus', 'estimatedDelivery',
          'courierPartner', 'consignmentId', 'courierTrackingUrl', 'dispatchedAtIso', 'updatedAt'
        ])
        && data.orderNumber is string && data.orderNumber.matches('^DG-[0-9]{4,8}$')
        && data.weight in ['250g', '500g', '1kg']
        && data.qty is number && data.qty >= 1 && data.qty <= 50
        && (!('qty250g' in data) || (data.qty250g is number && data.qty250g >= 0 && data.qty250g <= 50))
        && (!('qty500g' in data) || (data.qty500g is number && data.qty500g >= 0 && data.qty500g <= 50))
        && (!('qty1kg' in data) || (data.qty1kg is number && data.qty1kg >= 0 && data.qty1kg <= 50))
        && data.itemsSummary is string && data.itemsSummary.size() >= 3 && data.itemsSummary.size() <= 80
        && (!('subtotalBdt' in data) || (data.subtotalBdt is number && data.subtotalBdt > 0))
        && (!('deliveryFeeBdt' in data) || (data.deliveryFeeBdt is number && data.deliveryFeeBdt >= 0))
        && (!('discountBdt' in data) || (data.discountBdt is number && data.discountBdt >= 0))
        && (!('couponCode' in data) || (data.couponCode is string && data.couponCode.size() <= 32))
        && (!('deliveryZone' in data) || data.deliveryZone in ['dhaka', 'suburban', 'nationwide', 'remote'])
        && (!('district' in data) || (data.district is string && data.district.size() <= 80))
        && data.totalBdt is number && data.totalBdt > 0
        && data.paymentMethod in ['cod', 'bkash', 'nagad']
        && data.paymentStatus in ['cod_due', 'pending_verification', 'verified', 'failed']
        && data.status in ['pending', 'confirmed', 'processing', 'shipped', 'delivered', 'cancelled']
        && (!('reviewStatus' in data) || data.reviewStatus in ['none', 'manual_review', 'approved', 'rejected'])
        && data.estimatedDelivery is string && data.estimatedDelivery.size() <= 80
        && (!('courierPartner' in data) || data.courierPartner in ['steadfast', 'pathao', 'redx', 'manual'])
        && (!('consignmentId' in data) || (data.consignmentId is string && data.consignmentId.size() <= 80))
        && (!('courierTrackingUrl' in data) || (data.courierTrackingUrl is string && data.courierTrackingUrl.size() <= 300 && (data.courierTrackingUrl == '' || data.courierTrackingUrl.matches('^https://.*'))))
        && (!('dispatchedAtIso' in data) || (data.dispatchedAtIso is string && data.dispatchedAtIso.size() <= 48))
        && data.updatedAt == request.time;
    }

    function isValidBatch(data) {
      return data.keys().hasAll([
          'batchCode', 'originDistrict', 'milkSource', 'productionDate',
          'expiryDate', 'labReportStatus', 'labReportUrl', 'licenceDetails',
          'active', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'batchCode', 'originDistrict', 'milkSource', 'productionDate',
          'expiryDate', 'labReportStatus', 'labReportUrl', 'licenceDetails',
          'active', 'updatedAt'
        ])
        && data.batchCode is string && data.batchCode.size() >= 3 && data.batchCode.size() <= 40
        && data.originDistrict is string && data.originDistrict.size() <= 100
        && data.milkSource is string && data.milkSource.size() <= 140
        && data.productionDate is string && data.productionDate.size() <= 40
        && data.expiryDate is string && data.expiryDate.size() <= 40
        && data.labReportStatus is string && data.labReportStatus.size() <= 120
        && data.labReportUrl is string && data.labReportUrl.size() <= 300
        && data.licenceDetails is string && data.licenceDetails.size() <= 160
        && data.active is bool
        && data.updatedAt == request.time;
    }

    function isValidReview(data) {
      return data.keys().hasAll([
          'customerName', 'district', 'rating', 'comment', 'orderNumber',
          'verifiedPurchase', 'helpfulCount', 'photoData', 'status', 'createdAt'
        ])
        && data.keys().hasOnly([
          'customerName', 'district', 'rating', 'comment', 'orderNumber',
          'verifiedPurchase', 'helpfulCount', 'photoData', 'status', 'createdAt'
        ])
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 80
        && data.district is string && data.district.size() >= 2 && data.district.size() <= 80
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.comment is string && data.comment.size() >= 6 && data.comment.size() <= 600
        && data.orderNumber is string && data.orderNumber.size() <= 20
        && data.verifiedPurchase is bool
        && data.helpfulCount is number && data.helpfulCount >= 0
        && data.photoData is string && data.photoData.size() <= 180000
        && data.status in ['pending', 'approved', 'rejected'];
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountPct', 'minSubtotalBdt', 'active', 'updatedAt'])
        && data.keys().hasOnly([
          'code', 'discountPct', 'minSubtotalBdt', 'active',
          'expiresAt', 'maxUses', 'usedCount', 'stackableWithAdvance', 'descriptionEn',
          'updatedAt'
        ])
        && data.code is string && data.code.size() >= 3 && data.code.size() <= 32
        && data.discountPct is number && data.discountPct > 0 && data.discountPct <= 50
        && data.minSubtotalBdt is number && data.minSubtotalBdt >= 0
        && data.active is bool
        && (!('expiresAt' in data) || (data.expiresAt is string && data.expiresAt.size() <= 40))
        && (!('maxUses' in data) || (data.maxUses is number && data.maxUses >= 0))
        && (!('usedCount' in data) || (data.usedCount is number && data.usedCount >= 0))
        && (!('stackableWithAdvance' in data) || data.stackableWithAdvance is bool)
        && (!('descriptionEn' in data) || (data.descriptionEn is string && data.descriptionEn.size() <= 160))
        && data.updatedAt == request.time;
    }

    function isValidSubscriber(data) {
      return data.keys().hasAll(['email', 'lang', 'createdAt'])
        && data.keys().hasOnly(['email', 'lang', 'createdAt'])
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$')
        && data.lang in ['en', 'bn']
        && data.createdAt == request.time;
    }

    function isValidChatbotConfigKeys(data) {
      return data.keys().hasAll([
          'enabled', 'maintenanceMode', 'maintenanceMessageEn', 'maintenanceMessageBn',
          'botName', 'brandName', 'brandIntro', 'brandStory', 'brandMission',
          'founderInfo', 'productDescription', 'ingredients', 'taste', 'aroma',
          'texture', 'productionMethod', 'shelfLife', 'storageInstructions',
          'approvedClaims', 'currentOffers', 'district', 'city', 'googleMapsUrl',
          'directionsUrl', 'businessHours', 'openHourBst', 'closeHourBst',
          'closedDays', 'supportAvailabilityNote', 'deliveryPolicy', 'returnPolicy',
          'replacementPolicy', 'otherPaymentInfo', 'supportInstructions',
          'customInstructions', 'responseTone', 'responseLength', 'languageBehavior',
          'fallbackMessageBn', 'fallbackMessageEn', 'welcomeMessageBn',
          'welcomeMessageEn', 'quickQuestionsBn', 'quickQuestionsEn',
          'retentionDays', 'dailyRequestLimit', 'version', 'lastSyncStatus', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'enabled', 'maintenanceMode', 'maintenanceMessageEn', 'maintenanceMessageBn',
          'botName', 'brandName', 'brandIntro', 'brandStory', 'brandMission',
          'founderInfo', 'productDescription', 'ingredients', 'taste', 'aroma',
          'texture', 'productionMethod', 'shelfLife', 'storageInstructions',
          'approvedClaims', 'blockedClaims', 'approvedClaimsMeta', 'claimAuditHistory',
          'currentOffers', 'district', 'city', 'googleMapsUrl',
          'directionsUrl', 'businessHours', 'openHourBst', 'closeHourBst',
          'closedDays', 'supportAvailabilityNote', 'humanSupportEnabled',
          'slaStandardMinutes', 'slaUrgentMinutes', 'deliveryPolicy', 'returnPolicy',
          'replacementPolicy', 'otherPaymentInfo', 'supportInstructions',
          'customInstructions', 'responseTone', 'responseLength', 'languageBehavior',
          'synonyms', 'primaryModel', 'fallbackModel',
          'fallbackMessageBn', 'fallbackMessageEn', 'welcomeMessageBn',
          'welcomeMessageEn', 'quickQuestionsBn', 'quickQuestionsEn',
          'retentionDays', 'dailyRequestLimit', 'version', 'lastSyncStatus', 'updatedAt'
        ]);
    }

    function isValidChatbotConfigBrandFacts(data) {
      return data.enabled is bool
        && data.maintenanceMode is bool
        && data.maintenanceMessageEn is string && data.maintenanceMessageEn.size() <= 300
        && data.maintenanceMessageBn is string && data.maintenanceMessageBn.size() <= 400
        && data.botName is string && data.botName.size() >= 2 && data.botName.size() <= 60
        && data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 80
        && data.brandIntro is string && data.brandIntro.size() <= 800
        && data.brandStory is string && data.brandStory.size() <= 2500
        && data.brandMission is string && data.brandMission.size() <= 1000
        && data.founderInfo is string && data.founderInfo.size() <= 1000
        && data.productDescription is string && data.productDescription.size() <= 1500
        && data.ingredients is string && data.ingredients.size() <= 600
        && data.taste is string && data.taste.size() <= 400
        && data.aroma is string && data.aroma.size() <= 400
        && data.texture is string && data.texture.size() <= 400
        && data.productionMethod is string && data.productionMethod.size() <= 1200
        && data.shelfLife is string && data.shelfLife.size() <= 300
        && data.storageInstructions is string && data.storageInstructions.size() <= 800
        && data.approvedClaims is string && data.approvedClaims.size() <= 1200
        && data.currentOffers is string && data.currentOffers.size() <= 800;
    }

    function isValidChatbotConfigLocation(data) {
      return data.district is string && data.district.size() <= 80
        && data.city is string && data.city.size() <= 80
        && data.googleMapsUrl is string && data.googleMapsUrl.size() <= 300
        && data.directionsUrl is string && data.directionsUrl.size() <= 300
        && data.businessHours is string && data.businessHours.size() <= 200
        && data.openHourBst is number && data.openHourBst >= 0 && data.openHourBst <= 23
        && data.closeHourBst is number && data.closeHourBst >= 0 && data.closeHourBst <= 23
        && data.closedDays is string && data.closedDays.size() <= 80
        && data.supportAvailabilityNote is string && data.supportAvailabilityNote.size() <= 300
        && (!('humanSupportEnabled' in data) || data.humanSupportEnabled is bool)
        && (!('slaStandardMinutes' in data) || (data.slaStandardMinutes is number && data.slaStandardMinutes >= 15 && data.slaStandardMinutes <= 1440))
        && (!('slaUrgentMinutes' in data) || (data.slaUrgentMinutes is number && data.slaUrgentMinutes >= 5 && data.slaUrgentMinutes <= 720))
        && data.deliveryPolicy is string && data.deliveryPolicy.size() <= 1200
        && data.returnPolicy is string && data.returnPolicy.size() <= 1200
        && data.replacementPolicy is string && data.replacementPolicy.size() <= 1200
        && data.otherPaymentInfo is string && data.otherPaymentInfo.size() <= 800
        && data.supportInstructions is string && data.supportInstructions.size() <= 1200;
    }

    function isValidChatbotConfigBehavior(data) {
      return data.customInstructions is string && data.customInstructions.size() <= 4000
        && data.responseTone in ['warm', 'concise', 'formal']
        && data.responseLength in ['short', 'balanced', 'detailed']
        && data.languageBehavior in ['auto', 'prefer_bn', 'prefer_en', 'always_bn', 'mirror', 'customer_choice']
        && data.fallbackMessageBn is string && data.fallbackMessageBn.size() <= 400
        && data.fallbackMessageEn is string && data.fallbackMessageEn.size() <= 400
        && data.welcomeMessageBn is string && data.welcomeMessageBn.size() <= 500
        && data.welcomeMessageEn is string && data.welcomeMessageEn.size() <= 500
        && data.quickQuestionsBn is list && data.quickQuestionsBn.size() <= 8
        && (data.quickQuestionsBn.size() == 0 || data.quickQuestionsBn[0] is string)
        && data.quickQuestionsEn is list && data.quickQuestionsEn.size() <= 8
        && (data.quickQuestionsEn.size() == 0 || data.quickQuestionsEn[0] is string)
        && data.retentionDays is number && data.retentionDays >= 1 && data.retentionDays <= 365
        && data.dailyRequestLimit is number && data.dailyRequestLimit >= 10 && data.dailyRequestLimit <= 100000
        && data.version is number && data.version >= 1
        && data.lastSyncStatus is string && data.lastSyncStatus.size() <= 160
        && data.updatedAt == request.time;
    }

    function isValidChatbotConfigClaimsGovernance(data) {
      return (!('blockedClaims' in data) || (data.blockedClaims is string && data.blockedClaims.size() <= 800))
        && (!('approvedClaimsMeta' in data) || (data.approvedClaimsMeta is list && data.approvedClaimsMeta.size() <= 20 && (data.approvedClaimsMeta.size() == 0 || data.approvedClaimsMeta[0] is map)))
