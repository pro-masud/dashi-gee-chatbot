# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1800
GEMINI_DAILY_COST_CAP_USD=
GEMINI_INPUT_COST_PER_M_TOKENS=
GEMINI_OUTPUT_COST_PER_M_TOKENS=

# Order Token & Site URL (ORDER_TOKEN_SECRET must be >= 32 random chars in production)
ORDER_TOKEN_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase
FIREBASE_API_KEY=

# Optional Owner Notification Webhooks
OWNER_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Optional Cron Secret for automated /api/orders/refill-reminder/dispatch & /api/retention/campaigns triggers
CRON_SECRET=

# Optional Phase 5 Omnichannel Webhooks (Meta Messenger / Instagram & WhatsApp Cloud API)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

