# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_OUTPUT_TOKENS=1800
GEMINI_DAILY_COST_CAP_USD=
GEMINI_INPUT_COST_PER_M_TOKENS=
GEMINI_OUTPUT_COST_PER_M_TOKENS=
GEMINI_MODEL_COST_RATES_JSON=

# Order, Tracking, Session & Channel HMAC Secrets (>= 32 random chars in production; stored in Secret Manager)
ORDER_TOKEN_SECRET=
TRACKING_TOKEN_SECRET=
CHANNEL_SESSION_SECRET=
SESSION_COOKIE_SECRET=
RATE_LIMIT_SALT=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Policy modals stay hidden unless explicitly enabled as DRAFT previews for owner review
NEXT_PUBLIC_ENABLE_POLICY_DRAFTS=false
# Optional Firebase App Check enforcement on public write API routes
APP_CHECK_ENFORCE=false

# Firebase (Server uses Application Default Credentials — NEVER use service-account JSON keys)
FIREBASE_API_KEY=

# Optional Owner Notification Webhooks
OWNER_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Optional Cron Secret for automated /api/orders/refill-reminder/dispatch & /api/retention/campaigns triggers
CRON_SECRET=
# Optional Server-Internal Secret (>= 16 chars) for /api/orders/notify (falls back to CRON_SECRET if unset)
INTERNAL_NOTIFY_SECRET=

# Optional Phase 5 Omnichannel Webhooks (Meta Messenger / Instagram & WhatsApp Cloud API)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional Official Telegram Admin Notification Bot (Server-Only Secrets)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Official Discord Ops Webhooks (Server-Only Secrets — https://discord.com/api/webhooks/...)
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_ORDERS=
DISCORD_WEBHOOK_PAYMENTS=
DISCORD_WEBHOOK_SUPPORT=
DISCORD_WEBHOOK_INVENTORY=
DISCORD_WEBHOOK_REPORTS=
DISCORD_WEBHOOK_SYSTEM=

# Optional Durable Notification Queue Worker Secret (>= 32 random chars for Cloud Scheduler / cron)
NOTIFICATION_WORKER_SECRET=

# Optional Online Payment Gateways (SSLCommerz & bKash Tokenized Checkout)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_LIVE=false
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_IS_LIVE=false

# Optional Live Courier Booking & Webhook Sync (Steadfast, Pathao, RedX)
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_IS_LIVE=false
PATHAO_CITY_ZONE_MAP_JSON=
REDX_API_TOKEN=
REDX_IS_LIVE=false
REDX_AREA_ID_MAP_JSON=
COURIER_WEBHOOK_SECRET=

# Optional Direct SMS & Email Gateways (BulkSMSBD, Twilio, Resend)
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_NOTIFICATION_EMAIL=

# Optional Gemini TTS Voice (Kore, Puck, Charon, Fenrir, Zephyr)
GEMINI_TTS_VOICE=Kore

